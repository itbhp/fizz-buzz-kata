{
  "compilerOptions": {
    "target": "ES2019",
    "module": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "app"
  },
  "include": ["app/**/*"],
  "exclude": ["node_modules", "dist"]
}
